---
// Result display component for tool calculations
interface Props {
  title?: string;
  value?: string | number;
  unit?: string;
  subtitle?: string;
  color?: 'green' | 'blue' | 'orange';
  class?: string;
}

const {
  title = '',
  value = '',
  unit = '',
  subtitle = '',
  color = 'green',
  class: className = ''
} = Astro.props;
---

<div class={`result-box result-box--${color} ${className}`}>
  {title && <p class="result-title">{title}</p>}
  
  <div class="result-content">
    <div class="result-value">{value}</div>
    {unit && <span class="result-unit">{unit}</span>}
  </div>
  
  {subtitle && <p class="result-subtitle">{subtitle}</p>}
</div>

<style scoped>
  .result-box {
    padding: var(--space-2xl);
    border-radius: var(--radius-lg);
    text-align: center;
    background-color: var(--color-bg-secondary);
    border: 1px solid var(--color-border);
  }

  .result-box--blue {
    background-color: rgba(59, 130, 246, 0.05);
  }

  .result-box--orange {
    background-color: rgba(249, 115, 22, 0.05);
  }

  .result-title {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--space-md);
  }

  .result-content {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .result-value {
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-green);
  }

  .result-box--blue .result-value {
    color: var(--color-blue);
  }

  .result-box--orange .result-value {
    color: var(--color-orange);
  }

  .result-unit {
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-secondary);
  }

  .result-subtitle {
    font-size: 0.9rem;
    color: var(--color-text-secondary);
    margin: 0;
    font-weight: 500;
  }

  @media (max-width: 640px) {
    .result-box {
      padding: var(--space-xl);
    }

    .result-value {
      font-size: 2rem;
    }

    .result-content {
      gap: var(--space-sm);
    }
  }
</style>
