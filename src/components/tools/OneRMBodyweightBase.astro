---
import Card from '@/components/Card.astro';
import type { Language } from '@/lib/i18n';

interface FAQ {
  q: string;
  a: string;
}

interface TextConfig {
  h1: string;
  subtitle: string;
  unit: string;
  bodyweight: string;
  addedWeight: string;
  reps: string;
  rir: string;
  rirHelp: string;
  formula: string;
  hybrid: string;
  advancedSettings: string;
  calculate: string;
  copy: string;
  copied: string;
  resultTotal: string;
  resultAdded: string;
  formulas: string;
  epley: string;
  brzycki: string;
  lombardi: string;
  average: string;
  percentBodyweight: string;
  classification: string;
  standards: string;
  beginner: string;
  intermediate: string;
  advanced: string;
  elite: string;
  monster: string;
  inputError: string;
  faqTitle: string;
  seeAlso: string;
  goToRM: string;
  goToTools: string;
}

interface Config {
  storageKey: string;
  keyword: string;
  siteName: string;
  slugs: Record<Language, string>;
  genericRM: Record<Language, string>;
  toolsIndexLabel: Record<Language, string>;
  related: { slug: Record<Language, string>; label: Record<Language, string> };
  faqs: Record<Language, ReadonlyArray<FAQ>>;
  texts: Record<Language, TextConfig>;
}

interface Props {
  lang: Language;
  config: Config;
}

const { lang, config } = Astro.props;
const t = config.texts[lang];
const faqList = config.faqs[lang];
---

<Card hover gradient>
  <h1 style="margin-top: 0; margin-bottom: 0.75rem;">{t.h1}</h1>
  <p style="color: var(--color-text-secondary); margin-top: 0; margin-bottom: var(--space-lg);">{t.subtitle}</p>

  <form id={`${config.storageKey}-form`} style="display: grid; gap: var(--space-md);">
    <div style="display: flex; gap: var(--space-md); align-items: center;">
      <label for={`${config.storageKey}-unit`} style="font-size: 0.875rem; color: var(--color-text-secondary);">{t.unit}</label>
      <select id={`${config.storageKey}-unit`} style="padding: 0.5rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;">
        <option value="kg">kg</option>
        <option value="lb">lb</option>
      </select>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md);">
      <div style="display: grid; gap: 0.3rem;">
        <label for={`${config.storageKey}-bw`} style="font-size: 0.875rem;">{t.bodyweight}</label>
        <input id={`${config.storageKey}-bw`} type="number" min="30" max="250" step="0.1" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
      <div style="display: grid; gap: 0.3rem;">
        <label for={`${config.storageKey}-added`} style="font-size: 0.875rem;">{t.addedWeight}</label>
        <input id={`${config.storageKey}-added`} type="number" min="0" max="200" step="0.1" value="0" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
    </div>

    <div style="display: grid; gap: 0.3rem;">
      <label for={`${config.storageKey}-reps`} style="font-size: 0.875rem;">{t.reps}</label>
      <input id={`${config.storageKey}-reps`} type="number" min="1" max="12" step="1" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
    </div>

    <details style="border: 1px solid rgba(0,0,0,0.1); border-radius: 8px; padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.6);">
      <summary style="cursor: pointer; font-size: 0.9375rem; font-weight: 600; color: var(--color-text-primary); user-select: none;">
        {t.advancedSettings}
      </summary>

      <div style="display: grid; gap: var(--space-md); margin-top: var(--space-md);">
        <div style="display: grid; gap: 0.25rem;">
          <label for={`${config.storageKey}-rir`} style="font-size: 0.875rem; font-weight: 500;">{t.rir}</label>
          <input id={`${config.storageKey}-rir`} type="number" min="0" max="20" step="1" value="0" placeholder="0" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px; font-size: 1rem;" />
          <small style="color: var(--color-text-secondary);">{t.rirHelp}</small>
        </div>

        <div style="display: grid; gap: 0.25rem;">
          <label for={`${config.storageKey}-formula`} style="font-size: 0.875rem; font-weight: 500;">{t.formula}</label>
          <select id={`${config.storageKey}-formula`} style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px; font-size: 1rem;">
            <option value="hybrid">{t.hybrid}</option>
            <option value="epley">{t.epley}</option>
            <option value="brzycki">{t.brzycki}</option>
            <option value="lombardi">{t.lombardi}</option>
          </select>
        </div>
      </div>
    </details>

    <div id={`${config.storageKey}-error`} style="display: none; padding: 0.75rem; border-left: 4px solid var(--color-orange); background: rgba(249,115,22,0.12); border-radius: 8px;"></div>

    <button type="button" id={`${config.storageKey}-calculate`} style="padding: 0.875rem 1.5rem; background: linear-gradient(135deg, var(--color-green), var(--color-blue)); color: #fff; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">
      {t.calculate}
    </button>
  </form>


  <div id={`${config.storageKey}-results`} style="display: none; margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid rgba(0,0,0,0.08);">
    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md);">
      <div>
        <p style="color: var(--color-text-secondary); margin: 0 0 0.5rem 0; font-size: 0.875rem;">{t.resultTotal}</p>
        <div style="display: flex; align-items: baseline; gap: 0.35rem;">
          <span id={`${config.storageKey}-total`} data-value="0" style="font-size: 2.5rem; font-weight: 700; color: var(--color-green); opacity: 0; transition: opacity 0.3s ease;">0</span>
          <span id={`${config.storageKey}-total-unit`} style="font-size: 1.25rem; color: var(--color-text-secondary); font-weight: 500;"></span>
        </div>
      </div>
      <div>
        <p style="color: var(--color-text-secondary); margin: 0 0 0.5rem 0; font-size: 0.875rem;">{t.resultAdded}</p>
        <div style="display: flex; align-items: baseline; gap: 0.35rem;">
          <span id={`${config.storageKey}-added-result`} data-value="0" style="font-size: 2.5rem; font-weight: 700; color: var(--color-green); opacity: 0; transition: opacity 0.3s ease;">0</span>
          <span id={`${config.storageKey}-added-unit`} style="font-size: 1.25rem; color: var(--color-text-secondary); font-weight: 500;"></span>
        </div>
      </div>
    </div>

    <button type="button" id={`${config.storageKey}-copy`} style="margin-top: 0.75rem; border: 1px solid rgba(0,0,0,0.15); background: #fff; padding: 0.45rem 0.8rem; border-radius: 6px; cursor: pointer;">{t.copy}</button>

    <h3 style="margin-bottom: 0.5rem; margin-top: var(--space-lg);">{t.formulas}</h3>
    <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--space-sm);">
      <div><strong>{t.epley}:</strong> <span id={`${config.storageKey}-epley`}></span></div>
      <div><strong>{t.brzycki}:</strong> <span id={`${config.storageKey}-brzycki`}></span></div>
      <div><strong>{t.lombardi}:</strong> <span id={`${config.storageKey}-lombardi`}></span></div>
      <div style="grid-column: 1 / -1;"><strong>{t.average}:</strong> <span id={`${config.storageKey}-avg`}></span></div>
    </div>

    <p id={`${config.storageKey}-relative`} style="margin-top: var(--space-md);"></p>
    <p id={`${config.storageKey}-class`} style="margin-top: 0;"></p>

    <details open>
      <summary>{t.standards}</summary>
      <table style="width: 100%; border-collapse: collapse; margin-top: 0.5rem;">
        <thead>
          <tr style="background: rgba(0,0,0,0.03);">
            <th style="padding: 0.45rem; text-align: left;">{t.classification}</th>
            <th style="padding: 0.45rem; text-align: left;">{t.percentBodyweight}</th>
          </tr>
        </thead>
        <tbody>
          <tr><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">{t.beginner}</td><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">&lt; 20%</td></tr>
          <tr><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">{t.intermediate}</td><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">20% - 40%</td></tr>
          <tr><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">{t.advanced}</td><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">40% - 60%</td></tr>
          <tr><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">{t.elite}</td><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">60% - 80%</td></tr>
          <tr><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">{t.monster}</td><td style="padding: 0.45rem; border-top: 1px solid rgba(0,0,0,0.08);">&gt; 80%</td></tr>
        </tbody>
      </table>
    </details>
  </div>

  <section style="margin-top: var(--space-lg);">
    <h2 style="margin-bottom: 0.5rem;">{t.faqTitle}</h2>
    {faqList.map((item) => (
      <details style="margin-bottom: 0.75rem;">
        <summary>{item.q}</summary>
        <p style="margin-top: 0.5rem; color: var(--color-text-secondary);">{item.a}</p>
      </details>
    ))}
  </section>

  <section style="margin-top: var(--space-lg);">
    <h2 style="margin-bottom: 0.5rem;">{t.seeAlso}</h2>
    <ul style="margin: 0; padding-left: 1.1rem;">
      <li><a href={`/${lang}/tools/${config.related.slug[lang]}`}>{config.related.label[lang]}</a></li>
      <li><a href={`/${lang}/tools/${config.genericRM[lang]}`}>{t.goToRM}</a></li>
      <li><a href={`/${lang}/tools`}>{config.toolsIndexLabel[lang]}</a></li>
    </ul>
  </section>

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: t.h1,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'Web',
    description: t.subtitle,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    url: `https://fitprimelab.com/${lang}/tools/${config.slugs[lang]}`,
  })} />

  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqList.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  })} />
</Card>

<script define:vars={{ lang, config }}>
  const t = config.texts[lang];
  const unitEl = document.getElementById(`${config.storageKey}-unit`);
  const bwEl = document.getElementById(`${config.storageKey}-bw`);
  const addedEl = document.getElementById(`${config.storageKey}-added`);
  const repsEl = document.getElementById(`${config.storageKey}-reps`);
  const rirEl = document.getElementById(`${config.storageKey}-rir`);
  const formulaEl = document.getElementById(`${config.storageKey}-formula`);
  const calcBtn = document.getElementById(`${config.storageKey}-calculate`);
  const errorEl = document.getElementById(`${config.storageKey}-error`);
  const resultWrap = document.getElementById(`${config.storageKey}-results`);
  const copyBtn = document.getElementById(`${config.storageKey}-copy`);

  const fields = [bwEl, addedEl, repsEl];

  function toKg(value, unit) {
    return unit === 'lb' ? value * 0.45359237 : value;
  }

  function fromKg(value, unit) {
    return unit === 'lb' ? value / 0.45359237 : value;
  }

  function validateField(field) {
    if (!field || !field.value) return true;
    const value = Number(field.value);
    const min = field.min ? Number(field.min) : -Infinity;
    const max = field.max ? Number(field.max) : Infinity;
    const valid = Number.isFinite(value) && value >= min && value <= max;
    field.style.borderColor = valid ? 'rgba(0,0,0,0.1)' : 'var(--color-orange)';
    return valid;
  }

  function epley(w, r) {
    if (r <= 1) return w;
    return w * (1 + r / 30);
  }

  function brzycki(w, r) {
    if (r <= 1) return w;
    return w * (36 / (37 - r));
  }

  function lombardi(w, r) {
    if (r <= 1) return w;
    return w * Math.pow(r, 0.1);
  }

  function hybrid(w, r) {
    if (r <= 1) return w;
    const ep = epley(w, r);
    const brz = brzycki(w, r);
    const lom = lombardi(w, r);

    let wEpley = Math.max(0, 1 - (r - 2) / 10);
    let wBrzycki = 1 - Math.abs(r - 8) / 8;
    let wLombardi = (r - 2) / 12;

    const sum = wEpley + wBrzycki + wLombardi;
    return (ep * (wEpley / sum)) + (brz * (wBrzycki / sum)) + (lom * (wLombardi / sum));
  }

  function classify(percent) {
    if (percent < 20) return t.beginner;
    if (percent < 40) return t.intermediate;
    if (percent < 60) return t.advanced;
    if (percent < 80) return t.elite;
    return t.monster;
  }

  const saved = localStorage.getItem(config.storageKey);
  unitEl.value = saved === 'lb' || saved === 'kg' ? saved : (lang === 'en' ? 'lb' : 'kg');

  fields.forEach((field) => {
    if (!field) return;
    field.addEventListener('blur', () => validateField(field));
  });

  unitEl.addEventListener('change', () => {
    localStorage.setItem(config.storageKey, unitEl.value);
  });

  // ==================== ANIMATION ====================
  function animateNumber(element, end, isSameValue = false, duration = 500) {
    const startValue = parseFloat(element.textContent) || 0;
    let startTime = null;

    element.style.transition = 'none';

    if (isSameValue) {
      element.style.opacity = '0';
      element.style.transform = 'scale(0.2) rotate(-90deg)';
    } else {
      element.style.opacity = '0';
      element.style.transform = 'scale(1) translateY(10px)';
    }

    const step = (currentTime) => {
      if (!startTime) startTime = currentTime;
      const progress = Math.min((currentTime - startTime) / duration, 1);
      const easeOut = 1 - Math.pow(1 - progress, 3);

      element.style.opacity = easeOut;

      if (isSameValue) {
        let scale;
        if (easeOut < 0.6) {
          scale = 0.2 + easeOut / 0.6 * 1.0;
        } else {
          const bounce = Math.sin((easeOut - 0.6) / 0.4 * Math.PI) * 0.15;
          scale = 1.2 - 0.2 * ((easeOut - 0.6) / 0.4) + bounce;
        }
        const rotation = easeOut * 360;
        element.style.transform = `scale(${scale}) rotate(${rotation}deg)`;
      } else {
        const translateY = 10 * (1 - easeOut);
        element.style.transform = `scale(1) translateY(${translateY}px)`;
      }

      if (progress < 1) {
        const current = (startValue + (end - startValue) * progress).toFixed(1);
        element.textContent = current;
        requestAnimationFrame(step);
      } else {
        element.textContent = end.toFixed(1);
        element.style.opacity = '1';
        if (isSameValue) {
          element.style.transform = 'scale(1) rotate(360deg)';
        } else {
          element.style.transform = 'scale(1) translateY(0px)';
        }
      }
    };

    requestAnimationFrame(step);
  }

  calcBtn.addEventListener('click', () => {
    const unit = unitEl.value;
    const bodyweight = Number(bwEl.value);
    const addedWeight = Number(addedEl.value || 0);
    const reps = Number(repsEl.value);
    const rir = rirEl.value ? Number(rirEl.value) : 0;
    const formula = formulaEl.value;

    const valid = [bwEl, addedEl, repsEl].every(validateField);
    if (!valid || !Number.isFinite(bodyweight) || !Number.isFinite(addedWeight) || !Number.isFinite(reps) || reps < 1 || reps > 12) {
      errorEl.style.display = 'block';
      errorEl.textContent = t.inputError;
      resultWrap.style.display = 'none';
      return;
    }

    errorEl.style.display = 'none';

    const effectiveReps = reps + rir;
    const totalLoadKg = toKg(bodyweight + addedWeight, unit);
    const bodyweightKg = toKg(bodyweight, unit);

    let result;
    if (formula === 'hybrid') {
      result = hybrid(totalLoadKg, effectiveReps);
    } else if (formula === 'epley') {
      result = epley(totalLoadKg, effectiveReps);
    } else if (formula === 'brzycki') {
      result = brzycki(totalLoadKg, effectiveReps);
    } else {
      result = lombardi(totalLoadKg, effectiveReps);
    }

    const resultAddedKg = result - bodyweightKg;
    const relativePct = (resultAddedKg / bodyweightKg) * 100;
    const label = classify(relativePct);

    // Animate total 1RM
    const totalEl = document.getElementById(`${config.storageKey}-total`);
    const totalDisplay = fromKg(result, unit);
    const prevTotal = parseFloat(totalEl.getAttribute('data-value') || '0');
    const currTotal = Math.round(totalDisplay * 10) / 10;
    const isSameTotal = prevTotal === currTotal && prevTotal !== 0;
    totalEl.setAttribute('data-value', currTotal.toString());
    document.getElementById(`${config.storageKey}-total-unit`).textContent = unit;
    animateNumber(totalEl, totalDisplay, isSameTotal, 500);

    // Animate added weight 1RM
    const addedResultEl = document.getElementById(`${config.storageKey}-added-result`);
    const addedDisplay = Math.max(0, fromKg(resultAddedKg, unit));
    const prevAdded = parseFloat(addedResultEl.getAttribute('data-value') || '0');
    const currAdded = Math.round(addedDisplay * 10) / 10;
    const isSameAdded = prevAdded === currAdded && prevAdded !== 0;
    addedResultEl.setAttribute('data-value', currAdded.toString());
    document.getElementById(`${config.storageKey}-added-unit`).textContent = unit;
    animateNumber(addedResultEl, addedDisplay, isSameAdded, 500);

    if (formula === 'hybrid') {
      const ep = epley(totalLoadKg, effectiveReps);
      const brz = brzycki(totalLoadKg, effectiveReps);
      const lom = lombardi(totalLoadKg, effectiveReps);
      document.getElementById(`${config.storageKey}-epley`).textContent = `${fromKg(ep, unit).toFixed(1)} ${unit}`;
      document.getElementById(`${config.storageKey}-brzycki`).textContent = `${fromKg(brz, unit).toFixed(1)} ${unit}`;
      document.getElementById(`${config.storageKey}-lombardi`).textContent = `${fromKg(lom, unit).toFixed(1)} ${unit}`;
      document.getElementById(`${config.storageKey}-avg`).textContent = `${fromKg(result, unit).toFixed(1)} ${unit}`;
    } else {
      document.getElementById(`${config.storageKey}-epley`).textContent = formula === 'epley' ? `${fromKg(result, unit).toFixed(1)} ${unit}` : '-';
      document.getElementById(`${config.storageKey}-brzycki`).textContent = formula === 'brzycki' ? `${fromKg(result, unit).toFixed(1)} ${unit}` : '-';
      document.getElementById(`${config.storageKey}-lombardi`).textContent = formula === 'lombardi' ? `${fromKg(result, unit).toFixed(1)} ${unit}` : '-';
      document.getElementById(`${config.storageKey}-avg`).textContent = `${fromKg(result, unit).toFixed(1)} ${unit}`;
    }

    document.getElementById(`${config.storageKey}-relative`).textContent = `${t.percentBodyweight}: ${relativePct.toFixed(1)}%`;
    document.getElementById(`${config.storageKey}-class`).textContent = `${t.classification}: ${label}`;

    copyBtn.textContent = t.copy;
    copyBtn.onclick = async () => {
      await navigator.clipboard.writeText(`${t.h1}: ${fromKg(result, unit).toFixed(1)} ${unit} total / ${Math.max(0, fromKg(resultAddedKg, unit)).toFixed(1)} ${unit} added`);
      copyBtn.textContent = t.copied;
      setTimeout(() => {
        copyBtn.textContent = t.copy;
      }, 1500);
    };

    resultWrap.style.display = 'block';
  });
</script>
