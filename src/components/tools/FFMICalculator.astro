---
import Card from '@/components/Card.astro';
import type { Language } from '@/lib/i18n';
import type { Tool } from '@/lib/tools';
import { ffmiCalculatorI18n } from '@/i18n/tools/ffmi-calculator';

interface Props {
  lang: Language;
  tool: Tool;
}

const { lang, tool } = Astro.props;
const t = ffmiCalculatorI18n[lang];

const wilksSlugs = {
  en: 'wilks-calculator',
  es: 'calculadora-wilks',
  pt: 'calculadora-wilks',
  ja: 'wilks-keisanki'
};

const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: tool.name[lang],
  applicationCategory: 'HealthApplication',
  operatingSystem: 'Web',
  inLanguage: lang,
  description: tool.description[lang],
  url: `https://fitprimelab.com/${lang}/tools/${tool.slug[lang]}`
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: t.faq1q, acceptedAnswer: { '@type': 'Answer', text: t.faq1a } },
    { '@type': 'Question', name: t.faq2q, acceptedAnswer: { '@type': 'Answer', text: t.faq2a } },
    { '@type': 'Question', name: t.faq3q, acceptedAnswer: { '@type': 'Answer', text: t.faq3a } },
    { '@type': 'Question', name: t.faq4q, acceptedAnswer: { '@type': 'Answer', text: t.faq4a } },
    { '@type': 'Question', name: t.faq5q, acceptedAnswer: { '@type': 'Answer', text: t.faq5a } }
  ]
};
---

<script type="application/ld+json" set:html={JSON.stringify(appSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section style="margin-bottom: var(--space-xl);">
  <h1 style="margin-top: 0; margin-bottom: var(--space-md);">{t.h1}</h1>
  <p style="color: var(--color-text-secondary); margin-top: 0;">{t.subtitle}</p>
</section>

<Card hover gradient>
  <form id="ffmi-form" style="display: grid; gap: var(--space-md);">
    <div style="display: grid; gap: 0.25rem;">
      <label for="ffmi-unit" style="font-size: 0.875rem; font-weight: 500;">{t.unit}</label>
      <select id="ffmi-unit" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;">
        <option value="kg">kg/cm</option>
        <option value="lb">lb/ft+in</option>
      </select>
    </div>

    <div style="display: grid; gap: 0.25rem;">
      <label for="ffmi-sex" style="font-size: 0.875rem; font-weight: 500;">{t.sex}</label>
      <select id="ffmi-sex" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;">
        <option value="male">{t.male}</option>
        <option value="female">{t.female}</option>
      </select>
    </div>

    <div style="display: grid; gap: 0.25rem;">
      <label for="ffmi-weight" style="font-size: 0.875rem; font-weight: 500;">{t.weight}</label>
      <input id="ffmi-weight" type="number" step="0.1" min="0" placeholder="80" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
    </div>

    <div id="ffmi-height-metric" style="display: grid; gap: 0.25rem;">
      <label for="ffmi-height-cm" style="font-size: 0.875rem; font-weight: 500;">{t.height} (cm)</label>
      <input id="ffmi-height-cm" type="number" step="0.1" min="0" placeholder="180" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
    </div>

    <div id="ffmi-height-imperial" style="display: none; grid-template-columns: 1fr 1fr; gap: var(--space-sm);">
      <div style="display: grid; gap: 0.25rem;">
        <label for="ffmi-height-ft" style="font-size: 0.875rem; font-weight: 500;">{t.height} (ft)</label>
        <input id="ffmi-height-ft" type="number" step="1" min="0" placeholder="5" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
      <div style="display: grid; gap: 0.25rem;">
        <label for="ffmi-height-in" style="font-size: 0.875rem; font-weight: 500;">{t.height} (in)</label>
        <input id="ffmi-height-in" type="number" step="0.1" min="0" placeholder="11" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
    </div>

    <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.9375rem;">
      <input id="ffmi-use-measurements" type="checkbox" />
      {t.calculateFromMeasurements}
    </label>

    <div id="ffmi-manual-bf" style="display: grid; gap: 0.25rem;">
      <label for="ffmi-bf" style="font-size: 0.875rem; font-weight: 500;">{t.bodyFat}</label>
      <input id="ffmi-bf" type="number" step="0.1" min="1" max="70" placeholder="15" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
    </div>

    <div id="ffmi-measurements" style="display: none; gap: var(--space-sm);">
      <p style="margin: 0; font-size: 0.875rem; color: var(--color-text-secondary);">{t.measurementNote}</p>
      <div style="display: grid; gap: 0.25rem;">
        <label for="ffmi-neck" style="font-size: 0.875rem; font-weight: 500;">{t.neck}</label>
        <input id="ffmi-neck" type="number" step="0.1" min="0" placeholder="38" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
      <div style="display: grid; gap: 0.25rem;">
        <label for="ffmi-waist" style="font-size: 0.875rem; font-weight: 500;">{t.waist}</label>
        <input id="ffmi-waist" type="number" step="0.1" min="0" placeholder="84" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
      <div id="ffmi-hip-wrap" style="display: none; gap: 0.25rem;">
        <label for="ffmi-hip" style="font-size: 0.875rem; font-weight: 500;">{t.hip}</label>
        <input id="ffmi-hip" type="number" step="0.1" min="0" placeholder="95" style="padding: 0.75rem; border: 1px solid rgba(0,0,0,0.1); border-radius: 6px;" />
      </div>
    </div>

    <p id="ffmi-error" style="display: none; margin: 0; color: #b91c1c; background: #fee2e2; padding: 0.75rem; border-radius: 6px;"></p>

    <div style="display: flex; gap: var(--space-sm); flex-wrap: wrap;">
      <button type="button" id="ffmi-calc" style="padding: 0.875rem 1.25rem; background: linear-gradient(135deg, var(--color-green), var(--color-blue)); color: #fff; border: none; border-radius: 6px; font-weight: 600; cursor: pointer;">{t.calculate}</button>
      <button type="button" id="ffmi-clear" style="padding: 0.875rem 1.25rem; background: #fff; color: var(--color-text-primary); border: 1px solid rgba(0,0,0,0.16); border-radius: 6px; font-weight: 600; cursor: pointer;">{t.clear}</button>
    </div>
  </form>

  <div id="ffmi-result" style="display: none; margin-top: var(--space-lg); padding-top: var(--space-lg); border-top: 1px solid rgba(0,0,0,0.08);">
    <h3 style="margin-top: 0;">{t.resultTitle}</h3>
    <div style="display: grid; gap: 0.5rem;">
      <p style="margin: 0;"><strong>{t.lbm}:</strong> <span id="ffmi-lbm-value">0</span> kg</p>
      <p style="margin: 0;"><strong>{t.ffmi}:</strong> <span id="ffmi-value">0</span></p>
      <p style="margin: 0;"><strong>{t.adjustedFfmi}:</strong> <span id="ffmi-adjusted-value">0</span></p>
      <p style="margin: 0;"><strong>{t.classification}:</strong> <span id="ffmi-classification-value">-</span></p>
      <p style="margin: 0;"><strong>{t.naturalCeiling}:</strong> <span id="ffmi-ceiling-value">-</span></p>
    </div>
    <button type="button" id="ffmi-copy" style="margin-top: var(--space-md); padding: 0.625rem 1rem; border: 1px solid rgba(0,0,0,0.18); background: white; border-radius: 6px; cursor: pointer;">{t.copyResult}</button>
    <span id="ffmi-copy-msg" style="margin-left: 0.5rem; color: var(--color-green); font-size: 0.875rem; display: none;">{t.copied}</span>
  </div>
</Card>

<section style="margin-top: var(--space-lg);">
  <details open style="margin-bottom: var(--space-md);">
    <summary style="font-weight: 700; cursor: pointer;">{t.tableTitleMen}</summary>
    <table style="width: 100%; border-collapse: collapse; margin-top: var(--space-sm); font-size: 0.9375rem;">
      <tbody>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">&lt; 18</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryBelow}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">18 - 20</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryAverage}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">20 - 22</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryAbove}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">22 - 23</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryExcellent}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">23 - 26</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categorySuperior}</td></tr>
        <tr><td style="padding: 0.5rem;">&gt; 26</td><td style="padding: 0.5rem;">{t.categoryEnhanced}</td></tr>
      </tbody>
    </table>
  </details>

  <details open style="margin-bottom: var(--space-md);">
    <summary style="font-weight: 700; cursor: pointer;">{t.tableTitleWomen}</summary>
    <table style="width: 100%; border-collapse: collapse; margin-top: var(--space-sm); font-size: 0.9375rem;">
      <tbody>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">&lt; 16</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryBelow}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">16 - 18</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryAverage}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">18 - 20</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryAbove}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">20 - 21</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categoryExcellent}</td></tr>
        <tr><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">21 - 24</td><td style="padding: 0.5rem; border-bottom: 1px solid rgba(0,0,0,0.08);">{t.categorySuperior}</td></tr>
        <tr><td style="padding: 0.5rem;">&gt; 24</td><td style="padding: 0.5rem;">{t.categoryEnhanced}</td></tr>
      </tbody>
    </table>
  </details>
</section>

<section style="margin-top: var(--space-lg);">
  <h2 style="margin-top: 0;">{t.faqTitle}</h2>
  <div style="display: grid; gap: var(--space-md);">
    <details><summary style="font-weight: 600;">{t.faq1q}</summary><p>{t.faq1a}</p></details>
    <details><summary style="font-weight: 600;">{t.faq2q}</summary><p>{t.faq2a}</p></details>
    <details><summary style="font-weight: 600;">{t.faq3q}</summary><p>{t.faq3a}</p></details>
    <details><summary style="font-weight: 600;">{t.faq4q}</summary><p>{t.faq4a}</p></details>
    <details><summary style="font-weight: 600;">{t.faq5q}</summary><p>{t.faq5a}</p></details>
  </div>
</section>

<section style="margin-top: var(--space-lg);">
  <h3 style="margin-top: 0;">{t.linksTitle}</h3>
  <ul style="padding-left: 1rem; margin: 0; display: grid; gap: 0.4rem;">
    <li><a href={`/${lang}/tools/${wilksSlugs[lang]}`}>{t.toWilks}</a></li>
    <li><a href={`/${lang}/tools`}>{t.toTools}</a></li>
  </ul>
</section>

<script define:vars={{ lang, t }}>
  const form = document.getElementById('ffmi-form');
  const unitSelect = document.getElementById('ffmi-unit');
  const sexSelect = document.getElementById('ffmi-sex');
  const weightInput = document.getElementById('ffmi-weight');
  const heightMetric = document.getElementById('ffmi-height-metric');
  const heightImperial = document.getElementById('ffmi-height-imperial');
  const heightCmInput = document.getElementById('ffmi-height-cm');
  const heightFtInput = document.getElementById('ffmi-height-ft');
  const heightInInput = document.getElementById('ffmi-height-in');
  const useMeasurements = document.getElementById('ffmi-use-measurements');
  const manualBfWrap = document.getElementById('ffmi-manual-bf');
  const measurementsWrap = document.getElementById('ffmi-measurements');
  const neckInput = document.getElementById('ffmi-neck');
  const waistInput = document.getElementById('ffmi-waist');
  const hipWrap = document.getElementById('ffmi-hip-wrap');
  const hipInput = document.getElementById('ffmi-hip');
  const bfInput = document.getElementById('ffmi-bf');
  const calcBtn = document.getElementById('ffmi-calc');
  const clearBtn = document.getElementById('ffmi-clear');
  const errorBox = document.getElementById('ffmi-error');
  const resultBox = document.getElementById('ffmi-result');
  const lbmValue = document.getElementById('ffmi-lbm-value');
  const ffmiValue = document.getElementById('ffmi-value');
  const adjustedValue = document.getElementById('ffmi-adjusted-value');
  const classValue = document.getElementById('ffmi-classification-value');
  const ceilingValue = document.getElementById('ffmi-ceiling-value');
  const copyBtn = document.getElementById('ffmi-copy');
  const copyMsg = document.getElementById('ffmi-copy-msg');

  const UNIT_KEY = 'ffmi_unit';

  const toKg = (v, unit) => unit === 'lb' ? v * 0.45359237 : v;
  const toCm = (v, unit) => unit === 'lb' ? v * 2.54 : v;

  function showError(message) {
    errorBox.textContent = message;
    errorBox.style.display = 'block';
  }

  function clearError() {
    errorBox.style.display = 'none';
    errorBox.textContent = '';
  }

  function toHeightMeters(unit) {
    if (unit === 'lb') {
      const ft = Number(heightFtInput.value || 0);
      const inch = Number(heightInInput.value || 0);
      const totalIn = ft * 12 + inch;
      return totalIn * 0.0254;
    }
    return Number(heightCmInput.value || 0) / 100;
  }

  function getNavyBodyFat(sex, waistCm, neckCm, heightCm, hipCm) {
    if (sex === 'male') {
      const base = waistCm - neckCm;
      if (base <= 0 || heightCm <= 0) return null;
      return 495 / (1.0324 - 0.19077 * Math.log10(base) + 0.15456 * Math.log10(heightCm)) - 450;
    }
    const base = waistCm + hipCm - neckCm;
    if (base <= 0 || heightCm <= 0) return null;
    return 495 / (1.29579 - 0.35004 * Math.log10(base) + 0.221 * Math.log10(heightCm)) - 450;
  }

  function getClassification(adjusted, sex) {
    if (sex === 'male') {
      if (adjusted < 18) return t.categoryBelow;
      if (adjusted < 20) return t.categoryAverage;
      if (adjusted < 22) return t.categoryAbove;
      if (adjusted < 23) return t.categoryExcellent;
      if (adjusted <= 26) return t.categorySuperior;
      return t.categoryEnhanced;
    }
    if (adjusted < 16) return t.categoryBelow;
    if (adjusted < 18) return t.categoryAverage;
    if (adjusted < 20) return t.categoryAbove;
    if (adjusted < 21) return t.categoryExcellent;
    if (adjusted <= 24) return t.categorySuperior;
    return t.categoryEnhanced;
  }

  function validatePositive(input) {
    const value = Number(input.value);
    if (!input.value) return false;
    return value > 0;
  }

  function updateMode() {
    const unit = unitSelect.value;
    localStorage.setItem(UNIT_KEY, unit);
    if (unit === 'lb') {
      heightMetric.style.display = 'none';
      heightImperial.style.display = 'grid';
    } else {
      heightMetric.style.display = 'grid';
      heightImperial.style.display = 'none';
    }
  }

  function updateMeasurementVisibility() {
    const active = useMeasurements.checked;
    const sex = sexSelect.value;
    manualBfWrap.style.display = active ? 'none' : 'grid';
    measurementsWrap.style.display = active ? 'grid' : 'none';
    hipWrap.style.display = active && sex === 'female' ? 'grid' : 'none';
  }

  function calculate() {
    clearError();

    const unit = unitSelect.value;
    const sex = sexSelect.value;
    const weightRaw = Number(weightInput.value || 0);
    const heightM = toHeightMeters(unit);

    if (weightRaw <= 0 || heightM <= 0) {
      showError(t.errorRequired);
      return;
    }

    const weightKg = toKg(weightRaw, unit);
    let bodyFat = Number(bfInput.value || 0);

    if (useMeasurements.checked) {
      const neckRaw = Number(neckInput.value || 0);
      const waistRaw = Number(waistInput.value || 0);
      const hipRaw = Number(hipInput.value || 0);

      if (neckRaw <= 0 || waistRaw <= 0 || (sex === 'female' && hipRaw <= 0)) {
        showError(t.errorRequired);
        return;
      }

      const neckCm = toCm(neckRaw, unit);
      const waistCm = toCm(waistRaw, unit);
      const hipCm = toCm(hipRaw, unit);
      const heightCm = heightM * 100;
      const navyBf = getNavyBodyFat(sex, waistCm, neckCm, heightCm, hipCm);

      if (navyBf === null || !Number.isFinite(navyBf) || navyBf <= 1 || navyBf >= 70) {
        showError(t.errorPositive);
        return;
      }

      bodyFat = navyBf;
    }

    if (bodyFat <= 0 || bodyFat >= 70) {
      showError(t.errorRequired);
      return;
    }

    const lbm = weightKg * (1 - bodyFat / 100);
    const ffmi = lbm / (heightM * heightM);
    const adjusted = ffmi + 6.3 * (1.8 - heightM);

    lbmValue.textContent = lbm.toFixed(1);
    ffmiValue.textContent = ffmi.toFixed(2);
    adjustedValue.textContent = adjusted.toFixed(2);
    classValue.textContent = getClassification(adjusted, sex);
    ceilingValue.textContent = sex === 'male' ? 'FFMI 25' : 'FFMI 23';

    resultBox.style.display = 'block';
  }

  function clearAll() {
    form.reset();
    updateMode();
    updateMeasurementVisibility();
    clearError();
    resultBox.style.display = 'none';
  }

  function copyResult() {
    const text = `${t.ffmi}: ${ffmiValue.textContent} | ${t.adjustedFfmi}: ${adjustedValue.textContent} | ${t.classification}: ${classValue.textContent}`;
    navigator.clipboard.writeText(text).then(() => {
      copyMsg.style.display = 'inline';
      setTimeout(() => { copyMsg.style.display = 'none'; }, 1600);
    });
  }

  [weightInput, heightCmInput, heightFtInput, heightInInput, bfInput, neckInput, waistInput, hipInput].forEach((input) => {
    input.addEventListener('blur', () => {
      if (input.value && !validatePositive(input)) {
        showError(t.errorPositive);
      } else if (errorBox.textContent === t.errorPositive) {
        clearError();
      }
    });
  });

  unitSelect.addEventListener('change', updateMode);
  sexSelect.addEventListener('change', updateMeasurementVisibility);
  useMeasurements.addEventListener('change', updateMeasurementVisibility);
  calcBtn.addEventListener('click', calculate);
  clearBtn.addEventListener('click', clearAll);
  copyBtn.addEventListener('click', copyResult);

  const persistedUnit = localStorage.getItem(UNIT_KEY);
  if (persistedUnit === 'kg' || persistedUnit === 'lb') {
    unitSelect.value = persistedUnit;
  }

  updateMode();
  updateMeasurementVisibility();
</script>
