---
// Language Switcher Component
import { getAllLanguages, getLanguageName, type Language } from '@/lib/i18n';

interface Props {
  currentLang: Language;
  currentPath?: string;
  availableLanguages?: Language[];
  slugs?: Partial<Record<Language, string>>; // For tool/blog pages to switch with correct slug
  routeType?: 'tools' | 'tool' | 'blog' | 'page'; // Type of route to determine path structure
}

const { currentLang, currentPath = '', availableLanguages, slugs, routeType = 'page' } = Astro.props;

// Use provided available languages or default to all
const languagesToShow = availableLanguages || getAllLanguages();

// Determine the base path for language switching
const getUrlForLang = (lang: Language): string => {
  // If we have slugs and it's a tool/blog page, use the translated slug
  if (slugs && routeType !== 'page') {
    // Normalize routeType (tool -> tools)
    const normalizedRouteType = routeType === 'tool' ? 'tools' : routeType;
    const newSlug = slugs[lang];
    // Fall back to section listing when no translation exists for this language
    if (!newSlug) return `/${lang}/${normalizedRouteType}`;
    return `/${lang}/${normalizedRouteType}/${newSlug}`;
  }
  
  // Standard page navigation - just replace language
  if (!currentPath || currentPath === '/') {
    return `/${lang}/`;
  }
  
  // Replace the current language with the new one in the path
  const pathWithoutLang = currentPath.replace(`/${currentLang}/`, '/');
  return `/${lang}${pathWithoutLang}`;
};
---

<div class="language-switcher">
  <svg class="globe-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="10"/>
    <line x1="2" y1="12" x2="22" y2="12"/>
    <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
  </svg>
  <select
    id="lang-select"
    value={currentLang}
    onchange="window.location.href = this.value"
    class="lang-select"
  >
    {languagesToShow.map((lang) => (
      <option value={getUrlForLang(lang)} selected={lang === currentLang}>
        {getLanguageName(lang)}
      </option>
    ))}
  </select>
</div>

<style>
  .language-switcher {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: var(--space-sm);
  }

  .globe-icon {
    width: 1rem;
    height: 1rem;
    color: var(--color-text-secondary);
    flex-shrink: 0;
  }

  .lang-select {
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-primary);
    cursor: pointer;
    font-size: 0.875rem;
    font-family: inherit;
    color: var(--color-text-primary);
    transition: all 0.2s ease;
    appearance: none;
    background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='currentColor' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e");
    background-repeat: no-repeat;
    background-position: right 0.5rem center;
    background-size: 1.2em 1.2em;
    padding-right: 2rem;
  }

  .lang-select:hover {
    border-color: var(--color-blue);
    background-color: var(--color-bg-secondary);
  }

  .lang-select:focus {
    outline: none;
    border-color: var(--color-blue);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
  }
</style>

