---
// Blog Card Component
interface Props {
  title: string;
  description: string;
  date: string;
  author?: string;
  href: string;
  image?: string;
  tags?: string[];
}

const { title, description, date, author, href, image, tags = [] } = Astro.props;
---

<article style="border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden; margin-bottom: 2rem;">
  {image && (
    <img
      src={image}
      alt={title}
      style="width: 100%; height: 200px; object-fit: cover;"
    />
  )}

  <div style="padding: 1.5rem;">
    <h3 style="margin-top: 0;"><a href={href}>{title}</a></h3>

    <p style="color: #666; margin-bottom: 1rem;">{description}</p>

    <div style="font-size: 0.9rem; color: #999; margin-bottom: 0.5rem;">
      <p style="margin: 0;">
        {date}
        {author && <span> by {author}</span>}
      </p>
    </div>

    {tags.length > 0 && (
      <div style="margin-top: 1rem;">
        {tags.map((tag) => (
          <span
            style="display: inline-block; background-color: #f0f0f0; padding: 0.25rem 0.75rem; margin-right: 0.5rem; border-radius: 20px; font-size: 0.85rem; color: #666;"
          >
            #{tag}
          </span>
        ))}
      </div>
    )}
  </div>
</article>
