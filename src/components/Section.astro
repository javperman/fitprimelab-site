---
// Section wrapper component for visual separation
interface Props {
  title?: string;
  subtitle?: string;
  background?: 'default' | 'light' | 'primary';
  class?: string;
  style?: string;
}

const {
  title = '',
  subtitle = '',
  background = 'default',
  class: className = '',
  style = ''
} = Astro.props;
---

<section class={`section section--${background} ${className}`} {style}>
  {(title || subtitle) && (
    <div class="section-header">
      {title && <h2 class="section-title">{title}</h2>}
      {subtitle && <p class="section-subtitle">{subtitle}</p>}
    </div>
  )}
  
  <div class="section-content">
    <slot />
  </div>
</section>

<style scoped>
  .section {
    padding: var(--space-2xl) 0;
    border-radius: 0;
    margin-bottom: 0;
  }

  .section--default {
    background-color: transparent;
  }

  .section--light {
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, rgba(249, 250, 251, 0.8) 100%), var(--gradient-subtle-2);
    background-attachment: fixed;
    padding: var(--space-2xl) var(--space-md);
    margin: 0 calc(-1 * var(--space-md));
  }

  .section--primary {
    background: linear-gradient(135deg, var(--color-bg-secondary) 0%, rgba(249, 250, 251, 0.8) 100%), var(--gradient-subtle-2);
    background-attachment: fixed;
    padding: var(--space-2xl) var(--space-md);
    margin: 0 calc(-1 * var(--space-md));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .section-header {
    text-align: center;
    margin-bottom: var(--space-2xl);
  }

  .section-title {
    margin-top: 0;
    margin-bottom: var(--space-md);
  }

  .section-subtitle {
    font-size: 1rem;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .section-content {
    display: grid;
    gap: var(--space-lg);
  }

  @media (max-width: 640px) {
    .section {
      padding: var(--space-xl) 0;
    }

    .section--light,
    .section--primary {
      padding: var(--space-xl) var(--space-md);
    }

    .section-header {
      margin-bottom: var(--space-xl);
    }

    .section-subtitle {
      font-size: 0.95rem;
    }
  }
</style>
