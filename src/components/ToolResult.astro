---
// Tool Result Display Component
interface Props {
  label: string;
  value: string | number;
  unit?: string;
}

const { label, value, unit = '' } = Astro.props;
---

<div
  style="padding: 1.5rem; background-color: #f0f7ff; border-left: 4px solid #0066cc; margin-bottom: 1rem;"
>
  <p style="margin: 0; color: #666; font-size: 0.9rem;">{label}</p>
  <p style="margin: 0.5rem 0 0 0; font-size: 1.5rem; font-weight: bold; color: #0066cc;">
    {value} {unit}
  </p>
</div>
