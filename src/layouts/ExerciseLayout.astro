---
import BaseLayout from './BaseLayout.astro';
import SEOHead from '@/components/SEOHead.astro';
import Card from '@/components/Card.astro';
import type { Language } from '@/lib/i18n';

interface Step {
  title: string;
  text: string;
}

interface Props {
  title: string;
  description: string;
  lang: Language;
  slug: string;
  translationSlugs?: Partial<Record<Language, string>>;
  muscles: string[];
  equipment?: string[];
  difficulty?: 'beginner' | 'intermediate' | 'advanced';
  image?: string;
  steps: Step[];
  tips?: string[];
  relatedTools?: string[];
  datePublished: string;
  dateModified?: string;
}

const { title, description, lang, slug, translationSlugs, muscles, equipment, difficulty, image, steps, tips, relatedTools, datePublished, dateModified } = Astro.props;

const allSlugs: Partial<Record<Language, string>> = { [lang]: slug, ...(translationSlugs || {}) };

const baseUrl = 'https://fitprimelab.com';
const canonicalUrl = `${baseUrl}/${lang}/exercises/${slug}`;

// Labels
const homeLabels: Record<Language, string> = { en: 'Home', es: 'Inicio', pt: 'Início', ja: 'ホーム' };
const exercisesLabels: Record<Language, string> = { en: 'Exercises', es: 'Ejercicios', pt: 'Exercícios', ja: 'エクササイズ' };
const stepsLabels: Record<Language, string> = { en: 'Steps', es: 'Pasos', pt: 'Passos', ja: '手順' };
const tipsLabels: Record<Language, string> = { en: 'Tips', es: 'Consejos', pt: 'Dicas', ja: 'ポイント' };
const musclesLabels: Record<Language, string> = { en: 'Muscles', es: 'Músculos', pt: 'Músculos', ja: '使用筋肉' };
const equipmentLabels: Record<Language, string> = { en: 'Equipment', es: 'Equipamiento', pt: 'Equipamento', ja: '器具' };
const difficultyLabels: Record<Language, string> = { en: 'Difficulty', es: 'Dificultad', pt: 'Dificuldade', ja: '難易度' };
const relatedToolsLabels: Record<Language, string> = { en: 'Related tools', es: 'Herramientas relacionadas', pt: 'Ferramentas relacionadas', ja: '関連ツール' };

const difficultyNames: Record<string, Record<Language, string>> = {
  beginner: { en: 'Beginner', es: 'Principiante', pt: 'Iniciante', ja: '初心者' },
  intermediate: { en: 'Intermediate', es: 'Intermedio', pt: 'Intermediário', ja: '中級' },
  advanced: { en: 'Advanced', es: 'Avanzado', pt: 'Avançado', ja: '上級' },
};

const difficultyColors: Record<string, string> = {
  beginner: 'var(--color-green)',
  intermediate: 'var(--color-blue)',
  advanced: 'var(--color-orange)',
};

function formatSlugLabel(s: string): string {
  return s.split('-').map(w => {
    if (w === '1rm') return '1RM';
    if (w === 'rm') return 'RM';
    return w.charAt(0).toUpperCase() + w.slice(1);
  }).join(' ');
}

// JSON-LD: HowTo
const howToSchema = {
  '@context': 'https://schema.org',
  '@type': 'HowTo',
  name: title,
  description,
  url: canonicalUrl,
  image: image ? (image.startsWith('http') ? image : `${baseUrl}${image}`) : undefined,
  step: steps.map((s, i) => ({
    '@type': 'HowToStep',
    position: i + 1,
    name: s.title,
    text: s.text,
  })),
  ...(equipment && equipment.length > 0
    ? { tool: equipment.map(e => ({ '@type': 'HowToTool', name: e })) }
    : {}),
};

// JSON-LD: BreadcrumbList
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: homeLabels[lang], item: `${baseUrl}/${lang}` },
    { '@type': 'ListItem', position: 2, name: exercisesLabels[lang], item: `${baseUrl}/${lang}/exercises` },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalUrl },
  ],
};
---

<html lang={lang}>
  <SEOHead
    title={title}
    description={description}
    lang={lang}
    slugs={Object.keys(allSlugs).length > 0 ? allSlugs : undefined}
    route="/exercises/[slug]"
    image={image}
    type="article"
    article={{ datePublished, dateModified, author: 'Fit Prime Lab' }}
  />
  <body>
    <BaseLayout title={title} description={description} lang={lang} slugs={allSlugs} routeType="page">
      <script is:inline type="application/ld+json" set:html={JSON.stringify(howToSchema)} />
      <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

      <div style="max-width: 800px; margin: 0 auto;">
        <!-- Breadcrumbs -->
        <nav aria-label="breadcrumb" style="margin-bottom: var(--space-lg); font-size: 0.8125rem;">
          <ol style="display: flex; flex-wrap: wrap; gap: 0.375rem; align-items: center; list-style: none; padding: 0; margin: 0;">
            <li><a href={`/${lang}/`} style="color: var(--color-text-secondary); text-decoration: none;">{homeLabels[lang]}</a></li>
            <li style="color: var(--color-text-light);" aria-hidden="true">›</li>
            <li><a href={`/${lang}/exercises`} style="color: var(--color-text-secondary); text-decoration: none;">{exercisesLabels[lang]}</a></li>
            <li style="color: var(--color-text-light);" aria-hidden="true">›</li>
            <li style="color: var(--color-text-primary); font-weight: 500;" aria-current="page">{title}</li>
          </ol>
        </nav>

        <!-- Header -->
        {image && <img src={image} alt={title} style="margin-bottom: var(--space-xl); border-radius: var(--radius-lg);" />}

        <h1 style="margin-bottom: var(--space-md);">{title}</h1>

        <!-- Meta chips -->
        <div style="display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-bottom: var(--space-xl); padding-bottom: var(--space-lg); border-bottom: 1px solid var(--color-border);">
          {difficulty && (
            <span style={`padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8125rem; font-weight: 600; background: rgba(0,0,0,0.04); color: ${difficultyColors[difficulty]};`}>
              {difficultyLabels[lang]}: {difficultyNames[difficulty][lang]}
            </span>
          )}
          {muscles.map(m => (
            <span style="padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8125rem; background: rgba(16, 185, 129, 0.08); color: var(--color-green);">{m}</span>
          ))}
          {equipment && equipment.map(e => (
            <span style="padding: 0.25rem 0.75rem; border-radius: 999px; font-size: 0.8125rem; background: rgba(59, 130, 246, 0.08); color: var(--color-blue);">{e}</span>
          ))}
        </div>

        <p style="font-size: 1.125rem; color: var(--color-text-secondary); line-height: 1.8; margin-bottom: var(--space-2xl);">{description}</p>

        <!-- Steps -->
        <section style="margin-bottom: var(--space-2xl);">
          <h2 style="margin-top: 0; margin-bottom: var(--space-xl);">{stepsLabels[lang]}</h2>
          <ol style="list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-lg);">
            {steps.map((step, i) => (
              <li style="display: flex; gap: var(--space-lg); align-items: flex-start;">
                <span style="flex-shrink: 0; width: 2rem; height: 2rem; display: flex; align-items: center; justify-content: center; border-radius: 50%; background: var(--color-green); color: white; font-weight: 700; font-size: 0.875rem;">{i + 1}</span>
                <div>
                  <strong style="display: block; margin-bottom: 0.25rem; color: var(--color-text-primary);">{step.title}</strong>
                  <p style="margin: 0; color: var(--color-text-secondary); line-height: 1.7;">{step.text}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>

        <!-- Tips -->
        {tips && tips.length > 0 && (
          <section style="margin-bottom: var(--space-2xl); padding: var(--space-xl); background: rgba(59, 130, 246, 0.04); border-radius: var(--radius-lg); border: 1px solid rgba(59, 130, 246, 0.12);">
            <h2 style="margin-top: 0; margin-bottom: var(--space-lg); font-size: 1.25rem;">{tipsLabels[lang]}</h2>
            <ul style="list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-md);">
              {tips.map(tip => (
                <li style="display: flex; gap: var(--space-md); align-items: flex-start; color: var(--color-text-primary); line-height: 1.6;">
                  <span style="flex-shrink: 0; color: var(--color-blue); font-weight: 700;">→</span>
                  <span>{tip}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <!-- Extended content (MDX body) -->
        <article style="line-height: 1.8; margin-bottom: var(--space-2xl);">
          <slot />
        </article>

        <!-- Related Tools -->
        {relatedTools && relatedTools.length > 0 && (
          <div style="margin-bottom: var(--space-xl); padding: var(--space-xl); background: var(--color-bg-secondary); border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
            <p style="margin: 0 0 var(--space-md) 0; font-size: 0.75rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.07em; color: var(--color-text-secondary);">{relatedToolsLabels[lang]}</p>
            <div style="display: flex; flex-wrap: wrap; gap: var(--space-sm);">
              {relatedTools.map(toolSlug => (
                <a href={`/${lang}/tools/${toolSlug}`} style="display: inline-flex; align-items: center; padding: 0.4rem 0.875rem; background: white; border: 1px solid var(--color-border); border-radius: 999px; font-size: 0.875rem; font-weight: 500; color: var(--color-text-primary); text-decoration: none; transition: border-color 0.2s ease, color 0.2s ease;">
                  {formatSlugLabel(toolSlug)}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </BaseLayout>
  </body>
</html>
